{
  "color": {
    "neutral": {
      "cream": {
        "$value": "#f6f1e9",
        "$type": "color",
        "$description": "Page background — warm cream, like newsprint."
      },
      "card": {
        "$value": "#ede8df",
        "$type": "color",
        "$description": "Panel / well surface, slightly darker than the page."
      },
      "secondary": {
        "$value": "#e8e2d8",
        "$type": "color",
        "$description": "Subdued surface for secondary buttons and hovers."
      },
      "muted": {
        "$value": "#ddd8ce",
        "$type": "color",
        "$description": "Faint fills — track backgrounds, disabled wells."
      },
      "muted-ink": {
        "$value": "#5c5448",
        "$type": "color",
        "$description": "Low-emphasis text — captions, bylines, hints."
      },
      "ink": {
        "$value": "#16100a",
        "$type": "color",
        "$description": "Primary ink — body text, headlines, hairline rules."
      },
      "ink-hover": { "$value": "#2c2218", "$type": "color" },
      "ink-active": { "$value": "#3a2f22", "$type": "color" }
    },
    "accent": {
      "default": {
        "$value": "#9e1b1b",
        "$type": "color",
        "$description": "Masthead red — section labels, links, primary calls to action."
      },
      "hover": { "$value": "#7d1515", "$type": "color" },
      "active": { "$value": "#6a1111", "$type": "color" }
    },
    "feedback": {
      "success": { "$value": "#1a6b3c", "$type": "color" },
      "warning": { "$value": "#8b6914", "$type": "color" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.cream}", "$type": "color" },
      "card": { "$value": "{color.neutral.card}", "$type": "color" },
      "raised": { "$value": "{color.neutral.secondary}", "$type": "color" },
      "muted": { "$value": "{color.neutral.muted}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.ink}", "$type": "color" },
      "muted": { "$value": "{color.neutral.muted-ink}", "$type": "color" },
      "inverse": { "$value": "{color.neutral.cream}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.neutral.ink}", "$type": "color" }
    },
    "action": {
      "primary": { "$value": "{color.neutral.ink}", "$type": "color" },
      "primary-hover": { "$value": "{color.neutral.ink-hover}", "$type": "color" },
      "primary-active": { "$value": "{color.neutral.ink-active}", "$type": "color" },
      "danger": { "$value": "{color.accent.default}", "$type": "color" },
      "danger-hover": { "$value": "{color.accent.hover}", "$type": "color" },
      "danger-active": { "$value": "{color.accent.active}", "$type": "color" }
    }
  }
}
