{
  "color": {
    "neutral": {
      "0": { "$value": "#ffffff", "$type": "color" },
      "100": { "$value": "#f4f5f7", "$type": "color" },
      "200": { "$value": "#e2e4e9", "$type": "color" },
      "700": { "$value": "#3a3f4b", "$type": "color" },
      "900": { "$value": "#12141a", "$type": "color" }
    },
    "brand": {
      "500": { "$value": "#2f5eff", "$type": "color" },
      "600": { "$value": "#1f46d1", "$type": "color" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.0}", "$type": "color" },
      "raised": { "$value": "{color.neutral.100}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}", "$type": "color" },
      "inverse": { "$value": "{color.neutral.0}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}", "$type": "color" }
    },
    "action": {
      "primary": { "$value": "{color.brand.500}", "$type": "color" },
      "primary-hover": { "$value": "{color.brand.600}", "$type": "color" }
    }
  }
}
