{
  "name": "@news-ui/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Lit-based Web Component design system, news- prefixed custom elements",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.js",
    "!src/**/*.stories.js",
    "!src/test-setup"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.a11y.test.js\"",
    "test:a11y": "vitest run a11y",
    "prepublishOnly": "npm run lint && npm run test && npm run test:a11y"
  },
  "dependencies": {
    "@news-ui/tokens": "^0.1.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1"
  }
}
